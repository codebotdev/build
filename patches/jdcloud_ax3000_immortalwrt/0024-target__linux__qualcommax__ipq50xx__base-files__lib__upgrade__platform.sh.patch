 	linksys,mx2000|\
 	linksys,mx5500|\
@@ -244,3 +255,11 @@ platform_do_upgrade() {
 		;;
 	esac
 }
+
+platform_copy_config() {
+	case "$(board_name)" in
+	jdcloud,ax3000)
+		emmc_copy_config
+		;;
+	esac
+}
