diff --git a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
index 16aa187ec8..c69c7fa917 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
+++ b/target/linux/qualcommax/ipq50xx/base-files/etc/board.d/02_network
@@ -18,6 +18,7 @@ ipq50xx_setup_interfaces()
 		;;
 	cmcc,mr3000d-ci|\
 	cmcc,pz-l8|\
+	jdcloud,ax3000|\
 	linksys,mx2000|\
 	linksys,mx5500|\
 	linksys,spnmx56|\
@@ -32,9 +33,26 @@ ipq50xx_setup_interfaces()
 	esac
 }
 
+ipq50xx_setup_macs()
+{
+	local board="$1"
+	local label_mac=""
+
+	case "$board" in
+	jdcloud,ax3000)
+		# U-Boot supplies the GMAC addresses via the ethernet aliases.
+		label_mac=$(get_mac_label_dt)
+		[ -n "$label_mac" ] || return
+		ucidef_set_interface_macaddr "lan" "$label_mac"
+		ucidef_set_label_macaddr "$label_mac"
+		;;
+	esac
+}
+
 board_config_update
 board=$(board_name)
 ipq50xx_setup_interfaces $board
+ipq50xx_setup_macs "$board"
 board_config_flush
 
 exit 0
