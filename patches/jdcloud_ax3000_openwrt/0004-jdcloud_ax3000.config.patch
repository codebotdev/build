diff --git a/jdcloud_ax3000.config b/jdcloud_ax3000.config
new file mode 100644
index 0000000000000000000000000000000000000000..880be4b3b81462b53d8db7a98db24eb4d9d7b69f
--- /dev/null
+++ b/jdcloud_ax3000.config
@@ -0,0 +1,119 @@
+# JDCloud AX3000 / openwrt-nss-edma (stmmac + DSA NSS).
+# Adapted from ../jdcloud_ax3000/jdcloud_ax3000.config.
+# After updating and installing feeds, merge the optional modules first:
+# cat kmods.config jdcloud_ax3000.config > .config
+# make defconfig
+# make -j$(nproc)
+# Device selections take precedence. This is a single-device configuration.
+CONFIG_TARGET_qualcommax=y
+CONFIG_TARGET_qualcommax_ipq50xx=y
+CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_jdcloud_ax3000=y
+
+# Self-contained ImageBuilder with the packages from this build.
+CONFIG_IB=y
+CONFIG_IB_STANDALONE=y
+
+# NSS data plane for this tree. The runtime package pulls in the stmmac
+# glue, ECM, VLAN manager and DSA integration; no qca-nss-dsa-virt is used.
+CONFIG_PACKAGE_nss-tools-dwmac=y
+CONFIG_PACKAGE_block-mount=y
+CONFIG_PACKAGE_luci-app-nss=y
+CONFIG_PACKAGE_luci-app-build-info=y
+CONFIG_PACKAGE_nss-firmware=y
+CONFIG_NSS_FIRMWARE_VERSION_12_2=y
+CONFIG_NSS_MEM_PROFILE_MEDIUM=y
+CONFIG_PACKAGE_kmod-qca-nss-drv=y
+CONFIG_PACKAGE_kmod-qca-nss-ecm=y
+CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
+CONFIG_NSS_DRV_VLAN_ENABLE=y
+CONFIG_NSS_DRV_IPV6_ENABLE=y
+CONFIG_NSS_DRV_VIRT_IF_ENABLE=y
+CONFIG_ATH11K_NSS_SUPPORT=y
+CONFIG_ATH11K_MEM_PROFILE_512M=y
+CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
+CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
+CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
+
+# Device firmware, board data and eMMC overlay support.
+CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
+CONFIG_PACKAGE_ipq-wifi-jdcloud_ax3000=y
+CONFIG_PACKAGE_e2fsprogs=y
+CONFIG_PACKAGE_kmod-fs-ext4=y
+
+# Diagnostics retained from the ImmortalWrt configuration.
+CONFIG_KERNEL_PROC_PAGE_MONITOR=y
+CONFIG_KERNEL_SLUB_DEBUG=y
+# CONFIG_KERNEL_SLUB_DEBUG_ON is not set
+CONFIG_PACKAGE_luci=y
+CONFIG_LUCI_LANG_zh_Hans=y
+CONFIG_PACKAGE_iperf3=y
+CONFIG_PACKAGE_tcpdump=y
+CONFIG_PACKAGE_conntrack=y
+
+# Install the runtime repository URLs provided by extra-repo.
+# CONFIG_FEED_video is not set
+# CONFIG_FEED_nss is not set
+# CONFIG_FEED_extra is not set
+CONFIG_PACKAGE_extra-repo=y
+# CONFIG_PACKAGE_luci-app-cpufreq is not set
+
+CONFIG_PACKAGE_kmod-nft-tproxy=y
+CONFIG_PACKAGE_kmod-nft-socket=y
+CONFIG_PACKAGE_kmod-nft-nat=y
+CONFIG_PACKAGE_kmod-tun=y
+CONFIG_PACKAGE_kmod-veth=y
+CONFIG_PACKAGE_kmod-inet-diag=y
+CONFIG_PACKAGE_kmod-fs-btrfs=y
+CONFIG_PACKAGE_kmod-fs-exfat=y
+CONFIG_PACKAGE_kmod-fs-msdos=y
+CONFIG_PACKAGE_kmod-fs-ntfs3=y
+CONFIG_PACKAGE_kmod-nls-cp932=y
+CONFIG_PACKAGE_kmod-nls-cp936=y
+CONFIG_PACKAGE_kmod-nls-cp950=y
+CONFIG_PACKAGE_kmod-vrf=y
+CONFIG_PACKAGE_kmod-tls=y
+CONFIG_PACKAGE_kmod-bonding=y
+
+CONFIG_PACKAGE_luci-theme-material=y
+CONFIG_PACKAGE_nano-full=y
+CONFIG_PACKAGE_openssh-sftp-server=y
+CONFIG_PACKAGE_sysstat=y
+CONFIG_PACKAGE_bash=y
+CONFIG_PACKAGE_htop=y
+CONFIG_PACKAGE_curl=y
+CONFIG_PACKAGE_lsblk=y
+CONFIG_PACKAGE_lsof=y
+CONFIG_PACKAGE_strace=y
+CONFIG_PACKAGE_bind-dig=y
+CONFIG_PACKAGE_hostapd-utils=y
+# Include full DNS functionality and archive extraction in the firmware.
+# CONFIG_PACKAGE_dnsmasq is not set
+CONFIG_PACKAGE_dnsmasq-full=y
+CONFIG_PACKAGE_dnsmasq_full_nftset=y
+CONFIG_PACKAGE_unzip=y
+# Full wpad enables LuCI's 802.11k/v controls and WNM support.
+# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
+CONFIG_PACKAGE_wpad-mbedtls=y
+
+# Extra feed applications and additional optional packages.
+# =y includes a package in the image; =m builds it for the package repository.
+CONFIG_PACKAGE_luci-app-frpc-multi=m
+CONFIG_PACKAGE_luci-app-internet-check=y
+CONFIG_PACKAGE_luci-app-tproxy-lan=m
+CONFIG_PACKAGE_luci-app-openclash=m
+CONFIG_PACKAGE_luci-app-ttyd=y
+CONFIG_PACKAGE_luci-app-ddns=m
+CONFIG_PACKAGE_luci-app-upnp=m
+CONFIG_PACKAGE_luci-app-wol=m
+CONFIG_PACKAGE_luci-app-adguardhome=m
+CONFIG_PACKAGE_luci-proto-openvpn=m
+CONFIG_PACKAGE_openvpn-openssl=m
+CONFIG_PACKAGE_luci-app-natmap=m
+CONFIG_PACKAGE_luci-app-nlbwmon=m
+CONFIG_PACKAGE_luci-app-watchcat=y
+CONFIG_PACKAGE_luci-proto-wireguard=m
+CONFIG_PACKAGE_luci-app-rtp2httpd=m
+CONFIG_PACKAGE_ddns-scripts-cloudflare=m
+CONFIG_PACKAGE_wakeonlan=m
+CONFIG_PACKAGE_luci-app-usteer=y
+
