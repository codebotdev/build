# AX3000 DWMAC/DSA defaults and migration from old eth1-only bridges.
. /lib/functions.sh

# AX3000 always uses qca8k/DSA. A deferred switch probe must never choose
# the legacy unbind-and-program path. Also repair the exact LAN-only trunk
# configuration generated by the initial port when GMAC1 failed to probe.
if [ "$(board_name)" = "jdcloud,ax3000" ]; then
	# The conduit itself cannot replace DSA user ports in br-lan. Older
	# overlays can retain that network setting without the NSS migration
	# marker, so repair the exact eth1-only bridge independently of it.
	ax3000_restore_lan() {
		local name ports
		config_get name "$1" name
		config_get ports "$1" ports
		[ "$name" = "br-lan" ] && [ "$ports" = "eth1" ] || return 0
		uci -q delete "network.$1.ports"
		for port in lan1 lan2 lan3; do
			uci add_list "network.$1.ports=$port"
		done
	}
	config_load network
	config_foreach ax3000_restore_lan device
	# These options belonged to the removed switch-unbind topology.
	for option in trunk trunk_if extra_ports fabric switch_args switch_dev vtu; do
		uci -q delete "nss.general.$option"
	done
	uci set nss.general.topology='dsa'
	[ -n "$(uci -q get nss.general.enabled)" ] || uci set nss.general.enabled='1'
	[ -n "$(uci -q get nss.general.wifi_offload)" ] || uci set nss.general.wifi_offload='1'
	[ -n "$(uci -q get nss.general.fw_logbuf)" ] || uci set nss.general.fw_logbuf='256'
	[ -x /etc/init.d/qca-nss-drv ] && /etc/init.d/qca-nss-drv disable
	uci commit nss
	uci commit network
	exit 0
fi

exit 0
