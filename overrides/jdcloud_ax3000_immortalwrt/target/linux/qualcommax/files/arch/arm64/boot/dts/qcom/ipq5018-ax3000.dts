/dts-v1/;

#include "ipq5018.dtsi"
#include "ipq5018-dwmac.dtsi"
#include "ipq5018-qcn6122.dtsi"
#include "ipq5018-nss.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "JDCloud AX3000";
	compatible = "jdcloud,ax3000", "qcom,ipq5018";

	aliases {
		led-boot = &led_system_blue;
		led-failsafe = &led_system_red;
		led-running = &led_system_blue;
		led-upgrade = &led_system_red;
		serial0 = &blsp1_uart1;
		sdhc1 = &sdhc_1;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		label-mac-device = &gmac1;
	};

	chosen {
		bootargs-append = " swiotlb=1 coherent_pool=2M fstools_partname_fallback_scan=1 fstools_overlay_fstype=ext4 clk_ignore_unused pd_ignore_unused";
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&button_pins>;
		pinctrl-names = "default";

		wps-button {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};

		reset-button {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&tlmm 25 GPIO_ACTIVE_LOW>;
			linux,input-type = <1>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-0 = <&leds_pins>;
		pinctrl-names = "default";

		led_system_red: red {
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 33 GPIO_ACTIVE_HIGH>;
		};

		green {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 32 GPIO_ACTIVE_HIGH>;
		};

		led_system_blue: blue {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_POWER;
			gpios = <&tlmm 31 GPIO_ACTIVE_HIGH>;
		};
	};
};

&sdhc_1 {
	status = "okay";
	pinctrl-0 = <&emmc_pins>;
	pinctrl-names = "default";
	max-frequency = <192000000>;

	/delete-property/ mmc-hs400-1_8v;
	mmc-hs200-1_8v;
	mmc-ddr-1_8v;
};

&sleep_clk {
	clock-frequency = <32000>;
};

&xo_board_clk {
	clock-frequency = <24000000>;
	clock-div = <4>;
	clock-mult = <1>;
};

&blsp1_uart1 {
	status = "okay";
	pinctrl-0 = <&serial_0_pins>;
	pinctrl-names = "default";
};

&crypto {
	status = "okay";
};

&cryptobam {
	status = "okay";
};

&prng {
	status = "okay";
};

&qfprom {
	status = "okay";
};

&qpic_bam {
	status = "okay";
};

&tsens {
	status = "okay";
};

&tlmm {
	button_pins: button-state {
		pins = "gpio25", "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

	mdio1_pins: mdio-state {
		mdc-pins {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mdio-pins {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	leds_pins: leds-pins {
		mux {
			pins = "gpio31", "gpio32", "gpio33";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
	};

	emmc_pins: emmc-pins {
		clk-pins {
			pins = "gpio9";
			function = "sdc1_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cmd-pins {
			pins = "gpio8";
			function = "sdc1_cmd";
			drive-strength = <8>;
			bias-pull-up;
		};

		data-pins {
			pins = "gpio4", "gpio5", "gpio6", "gpio7";
			function = "sdc1_data";
			drive-strength = <8>;
			bias-disable;
		};
	};

	serial_0_pins: uart0-state {
		pins = "gpio20", "gpio21";
		function = "blsp0_uart0";
		bias-disable;
	};
};

&uniphy0 {
	status = "okay";
	/* This 6.12 GCC also serves SSDK boards and resolves these by name. */
	clock-output-names = "uniphy_gcc_rx", "uniphy_gcc_tx", "uniphy0_ref_clk";
	assigned-clocks = <&uniphy0 UNIPHY_CLK_REF>;
	assigned-clock-rates = <UNIPHY_REFCLK_25MHZ>;
};

&gmac0 {
	label = "wan";
	status = "okay";
};

&gmac1 {
	status = "okay";
	phy-mode = "sgmii";

	fixed-link {
		speed = <1000>;
		full-duplex;
	};
};

&mdio0 {
	status = "okay";
};

&mdio1 {
	status = "okay";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 39 GPIO_ACTIVE_LOW>;

	qca8337_0: ethernet-phy@0 {
		reg = <0>;
	};

	qca8337_1: ethernet-phy@1 {
		reg = <1>;
	};

	qca8337_2: ethernet-phy@2 {
		reg = <2>;
	};

	switch1: ethernet-switch@17 {
		compatible = "qca,qca8337";
		reg = <17>;
		#address-cells = <1>;
		#size-cells = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "cpu";
				phy-mode = "sgmii";
				ethernet = <&gmac1>;
				qca,sgmii-enable-pll;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};

			port@1 {
				reg = <1>;
				label = "lan3";
				phy-handle = <&qca8337_0>;
			};

			port@2 {
				reg = <2>;
				label = "lan2";
				phy-handle = <&qca8337_1>;
			};

			port@3 {
				reg = <3>;
				label = "lan1";
				phy-handle = <&qca8337_2>;
			};
		};
	};
};

&q6v5_wcss {
	/* PCIe1, UPD2, QCN6122 reset on the AX3000's GPIO 15. */
	boot-args = <0x2 4 2 15 0 0>;
};

&wifi {
	status = "okay";
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";
	qcom,ath11k-calibration-variant = "JDC-AX3000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4c400000>;
};

&wifi1 {
	nss-radio-priority = <1>;
	status = "okay";
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";
	qcom,ath11k-calibration-variant = "JDC-AX3000";
	qcom,ath11k-fw-memory-mode = <1>;
	qcom,bdf-addr = <0x4d100000>;
	qcom,m3-dump-addr = <0x4df00000>;
};

/* Match the IPQ5018 firmware capabilities used by the dwmac NSS stack. */
&nss0 {
	qcom,mid-frequency = <1000000000>;
	/delete-property/ qcom,clmap-enabled;
	/delete-property/ qcom,crypto-enabled;
	/delete-property/ qcom,ipsec-enabled;
	/delete-property/ qcom,gre-redir-enabled;
	/delete-property/ qcom,gre-redir-mark-enabled;
	/delete-property/ qcom,portid-enabled;
	/delete-property/ qcom,pvxlan-enabled;
	/delete-property/ qcom,udp-st-enabled;
};

&soc {
	/delete-node/ qcom,nss_crypto;
};
